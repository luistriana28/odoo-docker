[Unit]
Description=Odoo Open Source ERP and CRM
Requires=postgresql.service
After=network.target postgresql.service

[Service]
Type=simple
PermissionsStartOnly=true
SyslogIdentifier=odoo-server
User=odoo
Group=odoo
ExecStart=/home/odoo-18.0/odoo/odoo-bin --config=/home/odoo-18.0/odoo-server.conf
WorkingDirectory=/home/odoo-18.0/odoo
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target


conda activate

/opt/odoo/anaconda3/envs/odoo17/bin/python3.10